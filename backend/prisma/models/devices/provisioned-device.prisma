

enum ProvisionedDeviceStatus {
    AVAILABLE

    CLAIMED

    REVOKED

    RETIRED
}

enum DeviceType {
    CARD

    BRACELET

    RING

    KEYCHAIN

    STICKER
}

enum SecurityTier {
    BASIC

    SECURE
}



model ProvisionedDevice {
    id                      String                          @id @default(cuid())

    editionId               String

    edition                 DeviceEdition                   @relation(fields: [editionId], references: [id])

    serialNumber            String                          @unique

    activationCodeHash      String                          @unique

    deviceType              DeviceType

    securityTier            SecurityTier

    status                  ProvisionedDeviceStatus         @default(AVAILABLE)

    claimedAt               DateTime?

    createdAt               DateTime                        @default(now())
    updatedAt               DateTime                        @updatedAt

    sfcDevice               SfcDevice?


   @@map("provisioned_devices")
}