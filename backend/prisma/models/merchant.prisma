enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Merchant {
  id                            String                      @id @default(uuid())
  userId                        String                      @unique
  businessName                  String
  status                        MerchantStatus              @default(ACTIVE)

  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  user                          User                        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("merchants")
}