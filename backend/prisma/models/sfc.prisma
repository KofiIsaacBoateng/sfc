// SFC devices identity

enum SFCDeviceStatus {

  ACTIVE

  INACTIVE
  
  DISABLED

  LOST

}

model SfcDevice {
  id              String          @id @unique @default(uuid())

  userId          String

  hardwareToken   String          @unique
  chipType        String

  status          SFCDeviceStatus @default(INACTIVE)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sfc_devices")
}
