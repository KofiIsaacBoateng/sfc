model PushDevice {
  id                        String                      @id @default(uuid())
  userId                    String
  token                     String                      @unique
  platform                  String
  lastSeenAt                DateTime                    @default(now())
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}