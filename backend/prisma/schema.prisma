generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  
}

enum AccountStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum Role {
  USER
  MERCHANT
  ADMIN
}

enum DeviceStatus {
  ACTIVE
  DEACTIVATED
  REPORTED_LOST
}

model User {
  id              String          @id @unique @default(uuid())
  firebaseUid     String          @unique
  phoneNumber     String          @unique
  fullName        String?
  pinHash         String?
  status          AccountStatus   @default(PENDING_ONBOARDING)
  role            Role            @default(USER)
  photo           String?         
  sfcDevices      SfcDevice[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}


model SfcDevice {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hardwareToken String      @unique // The NTAG 215 unique chip ID string
  chipType     String       // 'NTAG_215_PROTOTYPE' or 'NTAG_424_DNA_PRODUCTION'
  status       DeviceStatus @default(ACTIVE)
  linkedAt     DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, status])
}