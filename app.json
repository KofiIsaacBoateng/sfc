{
  "expo": {
    "name": "sfc",
    "slug": "sfc",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "icon": "./assets/images/logo/logo.png",
    "scheme": "sfc",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sfc.sfc",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow sfc to protect your wallet data with Face ID biometric authentication."
      }
    },
    "android": {
      "package": "com.sfc.sfc",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo/logo.png",
          "resizeMode": "contain",
          "imageWidth": 150
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow KudiTap to scan your contactless bank or mobile money card."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a02daac0-e340-4432-84ff-9bd7f9db1402"
      }
    }
  }
}
